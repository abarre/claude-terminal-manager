{
  "name": "claude-terminal-manager",
  "displayName": "Agent Terminal Manager",
  "description": "Track AI agent sessions (Claude, Codex) in VS Code terminals with sidebar panel",
  "version": "2.0.0",
  "publisher": "abarre",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "claude",
    "terminal",
    "ai",
    "session",
    "claude-code",
    "codex"
  ],
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abarre/claude-terminal-manager"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeTerminalManagerSidebar",
          "title": "Agent Terminal Manager",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "claudeTerminalManagerSidebar": [
        {
          "id": "claudeTerminalManagerPanel",
          "name": "Terminals",
          "icon": "resources/icon.svg",
          "contextualTitle": "Agent Terminal Manager",
          "visibility": "visible",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeTerminalManager.renameSession",
        "title": "Rename",
        "icon": "$(pencil)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal",
        "title": "Focus Terminal",
        "icon": "$(arrow-right)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusRemoteTerminal",
        "title": "Focus Remote Terminal",
        "icon": "$(arrow-right)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusWindow",
        "title": "Focus Window",
        "icon": "$(window)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.resetState",
        "title": "Reset Terminal State",
        "icon": "$(trash)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.closeTerminal",
        "title": "Close Terminal",
        "icon": "$(trash)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.installHooks",
        "title": "Install Hooks",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.removeHooks",
        "title": "Remove Hooks",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.checkHooks",
        "title": "Check Hooks Status",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal0",
        "title": "Focus Session 0",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal1",
        "title": "Focus Session 1",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal2",
        "title": "Focus Session 2",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal3",
        "title": "Focus Session 3",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal4",
        "title": "Focus Session 4",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal5",
        "title": "Focus Session 5",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal6",
        "title": "Focus Session 6",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal7",
        "title": "Focus Session 7",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal8",
        "title": "Focus Session 8",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminal9",
        "title": "Focus Session 9",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusTerminalByIndex",
        "title": "Focus Session by Index",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.customizeShortcuts",
        "title": "Customize Terminal Shortcuts",
        "icon": "$(keyboard)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.newSession",
        "title": "New Claude Session",
        "icon": "$(add)",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.resumeSession",
        "title": "Resume Session",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.focusSession",
        "title": "Focus Session",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.closeSession",
        "title": "Close Session",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.renameSessionById",
        "title": "Rename Session",
        "category": "Agent Terminal Manager"
      },
      {
        "command": "claudeTerminalManager.refreshTickets",
        "title": "Refresh Tickets and History",
        "icon": "$(refresh)",
        "category": "Agent Terminal Manager"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeTerminalManager.newSession",
          "when": "view == claudeTerminalManagerPanel",
          "group": "navigation@1"
        },
        {
          "command": "claudeTerminalManager.refreshTickets",
          "when": "view == claudeTerminalManagerPanel",
          "group": "navigation@2"
        },
        {
          "command": "claudeTerminalManager.resetState",
          "when": "view == claudeTerminalManagerPanel",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeTerminalManager.resumeSession",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.focusSession",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.closeSession",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.renameSessionById",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.renameSession",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.focusTerminal",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.focusRemoteTerminal",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.focusWindow",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.closeTerminal",
          "when": "false"
        },
        {
          "command": "claudeTerminalManager.focusTerminalByIndex",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Agent Terminal Manager",
        "properties": {
          "claudeTerminalManager.sidebar.showNonClaudeTerminals": {
            "type": "boolean",
            "default": false,
            "description": "List all terminals in the sidebar, not just Claude sessions"
          },
          "claudeTerminalManager.status.verboseToolNames": {
            "type": "boolean",
            "default": true,
            "description": "Show tool name in status bar during PreToolUse (e.g. Running: Bash)"
          },
          "claudeTerminalManager.sidebar.showTerminalsFromAllWindows": {
            "type": "boolean",
            "default": true,
            "description": "Show terminals from all VS Code windows in the sidebar, not just the current window. Remote terminals show the project name next to their label."
          },
          "claudeTerminalManager.windowFocus.useMacOSAccessibility": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "On macOS, activate remote VS Code windows with the Accessibility API instead of the `code` CLI. This is faster, but requires Visual Studio Code to have Accessibility permission. If activation fails or the window title is ambiguous, the extension falls back to the `code` CLI."
          },
          "claudeTerminalManager.keyboard.enableTerminalShortcuts": {
            "type": "boolean",
            "default": false,
            "description": "Enable keyboard shortcuts to focus terminals by their position in the sidebar. Default: Ctrl+Alt+0–9. Customize individual bindings in Keyboard Shortcuts (search 'Focus Session')."
          },
          "claudeTerminalManager.keyboard.customize": {
            "type": "null",
            "markdownDescription": "Rebind shortcuts in the [Keyboard Shortcuts editor](command:claudeTerminalManager.customizeShortcuts). The default is `Ctrl+Alt+0–9`."
          },
          "claudeTerminalManager.sidebar.density": {
            "type": "string",
            "enum": [
              "comfortable",
              "compact"
            ],
            "default": "comfortable",
            "enumDescriptions": [
              "Show the status line under each session.",
              "One line per session; hide the status line."
            ],
            "description": "How much detail each session row shows."
          },
          "claudeTerminalManager.terminalTitle.maxLength": {
            "type": "number",
            "default": 30,
            "minimum": 0,
            "markdownDescription": "Show each session's state and name in its terminal tab title, cut to this many characters. Requires `terminal.integrated.tabs.title` set to `${sequence}`. Set to 0 to leave tab titles alone."
          },
          "claudeTerminalManager.history.hours": {
            "type": "number",
            "default": 168,
            "minimum": 0,
            "description": "List sessions that ended within this many hours under each project. Set to 0 to hide finished sessions."
          },
          "claudeTerminalManager.newSession.location": {
            "type": "string",
            "enum": [
              "editorMain",
              "editor",
              "beside",
              "panel"
            ],
            "default": "editorMain",
            "enumDescriptions": [
              "First editor group — the main area, never a split.",
              "Whichever editor group is active, which may be a split.",
              "Split beside the active editor group.",
              "Bottom terminal panel."
            ],
            "description": "Where New Claude Session and Resume open their terminal."
          },
          "claudeTerminalManager.newSession.command": {
            "type": "string",
            "default": "claude",
            "description": "Command run in a new session terminal. Resuming appends \"--resume <id>\"."
          },
          "claudeTerminalManager.newSession.resumeAutocompact": {
        "type": "number",
        "default": 400000,
        "minimum": 0,
        "markdownDescription": "Auto-compact window, in tokens, passed as `--autocompact` when resuming a session \u2014 a resumed conversation is already large, and the automatic window would compact it straight away. Claude accepts 100000\u20131000000. Set to 0 to leave the window alone."
      },
      "claudeTerminalManager.tickets.command": {
            "type": "string",
            "default": "",
            "markdownDescription": "Shell command printing ticket JSON on stdout, enabling the **Tickets** tab. Leave empty to hide the tab.\n\nExpected shape: `[{ \"ticket\": \"sc-1\", \"etat\": \"In Development\", \"titre\": \"...\", \"url\": \"...\", \"sessions\": [{ \"id\": \"<claude-session-uuid>\", \"nom\": \"...\", \"projet\": \"...\", \"fin\": 1700000000000 }] }]` (English keys `id`/`state`/`title`/`name`/`project`/`endedAt` are also accepted)."
          },
          "claudeTerminalManager.tickets.refreshSeconds": {
            "type": "number",
            "default": 60,
            "minimum": 15,
            "description": "How often to re-run the tickets command while the panel is visible."
          }
        }
      },
      {
        "title": "Agent Terminal Manager — Hooks",
        "properties": {
          "claudeTerminalManager.hooks.manage": {
            "type": "null",
            "markdownDescription": "Manage agent hooks in `~/.claude/settings.json` and `~/.codex/hooks.json`:\n\n[$(plug) Install Hooks](command:claudeTerminalManager.installHooks) | [$(trash) Remove Hooks](command:claudeTerminalManager.removeHooks) | [$(search) Check Status](command:claudeTerminalManager.checkHooks)"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "claudeTerminalManager.focusTerminal0",
        "key": "ctrl+alt+0",
        "mac": "ctrl+alt+0",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal0",
        "key": "ctrl+alt+numpad0",
        "mac": "ctrl+alt+numpad0",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal1",
        "key": "ctrl+alt+1",
        "mac": "ctrl+alt+1",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal1",
        "key": "ctrl+alt+numpad1",
        "mac": "ctrl+alt+numpad1",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal2",
        "key": "ctrl+alt+2",
        "mac": "ctrl+alt+2",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal2",
        "key": "ctrl+alt+numpad2",
        "mac": "ctrl+alt+numpad2",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal3",
        "key": "ctrl+alt+3",
        "mac": "ctrl+alt+3",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal3",
        "key": "ctrl+alt+numpad3",
        "mac": "ctrl+alt+numpad3",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal4",
        "key": "ctrl+alt+4",
        "mac": "ctrl+alt+4",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal4",
        "key": "ctrl+alt+numpad4",
        "mac": "ctrl+alt+numpad4",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal5",
        "key": "ctrl+alt+5",
        "mac": "ctrl+alt+5",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal5",
        "key": "ctrl+alt+numpad5",
        "mac": "ctrl+alt+numpad5",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal6",
        "key": "ctrl+alt+6",
        "mac": "ctrl+alt+6",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal6",
        "key": "ctrl+alt+numpad6",
        "mac": "ctrl+alt+numpad6",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal7",
        "key": "ctrl+alt+7",
        "mac": "ctrl+alt+7",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal7",
        "key": "ctrl+alt+numpad7",
        "mac": "ctrl+alt+numpad7",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal8",
        "key": "ctrl+alt+8",
        "mac": "ctrl+alt+8",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal8",
        "key": "ctrl+alt+numpad8",
        "mac": "ctrl+alt+numpad8",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal9",
        "key": "ctrl+alt+9",
        "mac": "ctrl+alt+9",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      },
      {
        "command": "claudeTerminalManager.focusTerminal9",
        "key": "ctrl+alt+numpad9",
        "mac": "ctrl+alt+numpad9",
        "when": "config.claudeTerminalManager.keyboard.enableTerminalShortcuts"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "claudeTerminalManager.focusTerminal0",
        "claudeTerminalManager.focusTerminal1",
        "claudeTerminalManager.focusTerminal2",
        "claudeTerminalManager.focusTerminal3",
        "claudeTerminalManager.focusTerminal4",
        "claudeTerminalManager.focusTerminal5",
        "claudeTerminalManager.focusTerminal6",
        "claudeTerminalManager.focusTerminal7",
        "claudeTerminalManager.focusTerminal8",
        "claudeTerminalManager.focusTerminal9",
        "claudeTerminalManager.focusTerminalByIndex"
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview/tsconfig.json",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "tsc -p test/tsconfig.json",
    "test:e2e": "vscode-test",
    "lint": "eslint src --ext ts",
    "build-install": "pnpm compile && pnpm exec vsce package --no-dependencies && code --install-extension $(ls -t claude-terminal-manager-*.vsix | head -1)"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.0",
    "effect": "^3.0.0"
  }
}
